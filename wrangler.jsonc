{
  "name": "betterway-logistic-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/quote"],
    "html_handling": "drop-trailing-slash"
  },
  // LIVE: enquiries go to Betterway, sent with their own Resend key.
  "vars": {
    "NOTIFY_TO": "betterwaylogistic4you@gmail.com",
    "RESEND_FROM": "Better Way Logistic <no-reply@betterwaylogistic.co.uk>",
    "DRY_RUN": "0"
  },
  "ratelimits": [
    { "name": "CHAT_LIMIT", "namespace_id": "2401", "simple": { "limit": 30, "period": 60 } },
    { "name": "LEAD_LIMIT", "namespace_id": "2403", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
