{
  "name": "betterway-logistic-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/quote"],
    "html_handling": "drop-trailing-slash"
  },
  // TESTING: enquiries go to Andra, and DRY_RUN "1" means no email is sent at all.
  // Before going live: NOTIFY_TO -> betterwaylogistic4you@gmail.com and DRY_RUN -> "0".
  "vars": {
    "NOTIFY_TO": "andradudan4@gmail.com",
    "RESEND_FROM": "Betterway Logistic Website <leads@frontdesk.org.uk>",
    "DRY_RUN": "1"
  },
  "ratelimits": [
    { "name": "CHAT_LIMIT", "namespace_id": "2401", "simple": { "limit": 30, "period": 60 } },
    { "name": "LEAD_LIMIT", "namespace_id": "2403", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
